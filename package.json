{
  "name": "slide-roller",
  "version": "3.1.6",
  "description": "Professional image slideshow player with 4 independent players and hardware output support",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check:signing": "node scripts/check-signing.js",
    "build:addon": "node-gyp rebuild",
    "rebuild:addon": "electron-rebuild -f -w decklink_addon",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "postinstall": "electron-builder install-app-deps",
    "format": "prettier --write \"src/**/*.{js,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,html,css}\""
  },
  "keywords": [
    "slideshow",
    "media-player",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "node-addon-api": "^7.0.0",
    "node-gyp": "^12.4.0",
    "prettier": "^3.8.3"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-store": "^8.1.0",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.slideroller.app",
    "productName": "Slide Roller",
    "afterSign": "scripts/notarize.js",
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/sharp-libvips-*/**",
      "**/node_modules/@img/sharp-*/**",
      "**/node_modules/ffmpeg-static/**",
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "notarize": false,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "identity": "Developer ID Application",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns"
    },
    "files": [
      "src/**/*",
      "!src/native/decklink/**",
      "assets/**/*",
      "build/Release/decklink_addon.node",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    }
  }
}
